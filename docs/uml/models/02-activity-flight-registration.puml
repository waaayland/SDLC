@startuml
' Диаграмма активности: Предполётный осмотр и регистрация полёта (UML 2.5, стиль СТП 01-2024)
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 11

start
:Оператор открывает диалог\n«Регистрация полёта» (Tab / Enter / Esc);
:Выбрать борт, оператора, исправную АКБ;\nввести дату, время взлёта/посадки, задачу и район;
:Авторасчёт длительности полёта\n(duration = посадка − взлёт);

if (0 < duration <= 720 мин?) then ([нет])
  :Вывести ошибку валидации времени;\nзаблокировать кнопку «Сохранить»;
  stop
else ([да])
  :Выполнить 5-факторную проверку допуска\nAdmissionService::evaluate() {<= 200 мс};
  note right
    5 факторов допуска (REQ-FUNC-006-3, F-15):
    1) uavOk: статус борта == Исправен
    2) maintOk: нет просроченных видов ТО
    3) operatorOk: допуск действует и на тип БЛА
    4) batteryOk: циклы АКБ < max_cycles
    5) preflightOk: осмотр F-15 на дату пройден
  end note

  if (Все 5 факторов выполнены?) then ([нет — отказ])
    :Вывести перечень причин отказа;\nоставить кнопку «Сохранить» неактивной;
    if (Отсутствует предполётный осмотр?) then ([да])
      :Перейти в диалог\n«Предполётный осмотр» (UC-04);
      stop
    else ([нет])
      :Отменить ввод (Esc) и уведомить\nтехника / начальника службы;
      stop
    endif
  else ([да — допущен])
    :Отобразить статус «ДОПУЩЕН К ПОЛЁТУ»;\nактивировать кнопку «Сохранить»;
    :Оператор нажимает «Сохранить» (Enter);
    :Проверить права через RbacGuard\n(роль Оператор или Администратор);

    if (Права RBAC подтверждены?) then ([нет])
      :Отклонить операцию (отказ доступа)\nи записать событие в журнал ошибок;
      stop
    else ([да])
      :Открыть транзакцию SQLite WAL\nBEGIN IMMEDIATE (DatabaseManager);
      :INSERT запись полёта в таблицу flights;

      fork
        :Детерминированно пересчитать\nналёт и число полётов (SUM/COUNT);
      fork again
        :Пересчитать циклы АКБ\n(COUNT по flights);
      fork again
        :Вычислить остатки до ТО\n(MaintenanceEngine);
      fork again
        :Записать событие\nв audit_log (UC-11);
      end fork

      if (Достигнут порог ТО (остаток <= 0)?) then ([да])
        :UavStateMachine: перевод борта\n«Исправен» -> «Требуется ТО»;
      else ([нет])
      endif

      if (Все операции транзакции успешны?) then ([да])
        :COMMIT транзакции SQLite WAL;
        :Обновить таблицу парка БЛА\nи панель предупреждений (UC-05c);
        stop
      else ([нет — сбой записи])
        :ROLLBACK транзакции (REQ-REL-001);\nзаписать диагностику в uavlog.log;
        :Показать сообщение об ошибке\n(целостность БД сохранена);
        stop
      endif
    endif
  endif
endif
@enduml
